    "def standardize_spectrum(X):\n",
    "    mean = np.nanmean(X, axis=1, keepdims=True)\n",
    "    std = np.nanstd(X, axis=1, keepdims=True)\n",
    "\n",
    "    std[std == 0] = 1.0\n",
    "\n",
    "    X_std = (X - mean) / std\n",
    "    X_std[~np.isfinite(X_std)] = 0.0\n",
    "\n",
    "    return X_std.astype(np.float32)"
   ]
  },
